# Copy to .env for local development. On Render, set these in the dashboard.
ENVIRONMENT=development

# Local: SQLite file. Production (Aiven / TiDB MySQL):
# DATABASE_URL=mysql+aiomysql://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Generate long random values, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
OTP_PEPPER=change-me-too
JOB_SECRET=change-me-job-secret

# The website calls the API through its own /api proxy, so cookies are first-party.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
# Production (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Gmail SMTP with an App Password. Leave SMTP_USER empty to print emails (OTP codes) in the console.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Dhaka Home Shifting

# Cloudinary (free). Leave empty to save uploads in ./uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
